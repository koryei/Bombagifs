# The status card shown by the Discord app after connecting, after every
# reconnect, and whenever this file changes while Bombagif is running
# (checked every 15 seconds, so no restart is needed).
#
# status: online, idle, dnd, invisible
# activity_type: playing, listening, watching, competing, streaming, custom
[status]
status = online
activity_type = playing

# Card title. Leave blank to use activity_text instead.
activity_name = Bombagifs

# Compact card text to avoid mobile truncation.
details = Convert video & images to optimized GIFs
state = Run /gif in DMs, groups, or servers

# Optional card button (max 32 characters). `user-install` builds the OAuth URL
# with the live application ID and integration_type=1 (no ID placeholder needed).
# For a literal URL, replace YOUR_CLIENT_ID with the ID from the Developer Portal.
# Discord only sends button labels over the gateway, so the URL is also attached
# as a clickable link on the state line.
button_label = Try It Out
button_url = user-install

# Rich Presence image key must exactly match the key uploaded in the Developer Portal.
large_image = bombagif_logo
large_text = Bombagif Optimizer
# small_image = bombagif_badge
# small_text = Bombagif

# Simple one-line alternative to details/state, kept for a minimal presence.
# activity_text = /gif | your images to GIFs

# Optional emoji shown only for activity_type = custom. Example: activity_emoji = ✨

# Required only for activity_type = streaming. Must be an HTTPS URL.
# streaming_url = https://www.twitch.tv/your_channel
