# YOUR Discord application bot token from Developer Portal > Bot.
DISCORD_TOKEN=

# YOUR Zipline API token from your own Zipline account.
ZIPLINE_TOKEN=

# Base URL of YOUR Zipline instance (must use HTTPS).
ZIPLINE_URL=https://your-zipline.example.com

# Optional comma-separated guild IDs to restrict server-context use.
# Leave blank for a public user-installed command.
ALLOWED_GUILDS=

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Transparent pixels are flattened onto this RGB color in GIF output.
GIF_BACKGROUND=#FFFFFF
