# YOUR Discord application bot token from Developer Portal > Bot.
DISCORD_TOKEN=

# YOUR Zipline API token from your own Zipline account.
ZIPLINE_TOKEN=

# Base URL of YOUR Zipline instance (must use HTTPS).
ZIPLINE_URL=https://your-zipline.example.com

# Optional comma-separated guild IDs to restrict server-context use.
# Leave blank for a public user-installed command.
ALLOWED_GUILDS=

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Transparent pixels are flattened onto this RGB color in GIF output.
GIF_BACKGROUND=#FFFFFF

# Self-bot (selfbot.py) only. A USER-account token: automating a user account violates Discord's
# Terms of Service, so use a throwaway/alt account. Never share this value.
SELFBOT_TOKEN=
# Where the DM allowlist (allowlist.json) is stored.
SELFBOT_DATA_DIR=data
# Accept incoming friend requests automatically (off by default). Accepting never registers anyone;
# they still have to DM first. Paced, and paused automatically if Discord asks for a CAPTCHA.
SELFBOT_AUTO_ACCEPT_FRIENDS=false
# Terminal look: auto (pretty on a terminal, JSON logs when redirected or under systemd/Docker),
# pretty (banner + live panel + coloured logs), or json.
SELFBOT_UI=auto

# --- Clip scout (v3, self-bot only) ------------------------------------------------------------------------
# Watches chats YOU enable, finds messages that are funny out of context, and posts them as a quote card that
# names who is in it. Off by default. Read the README section "Clip scout" (privacy, ToS, opt-outs) first.
#   off      = nothing happens        dry-run = judge and log what it WOULD clip, post nothing (start here)
#   on       = post clips
SELFBOT_SCOUT_MODE=off
# Your own Discord user id: the only person who can run !scout on / off / status / list.
SELFBOT_OWNER_ID=
# Optional: chat ids that are always enabled (comma-separated). Normally you just type !scout on in a chat.
SELFBOT_SCOUT_CHATS=

# Who judges. auto = Inception, then your OpenAI-compatible model, then "heuristic" (which never posts).
SCOUT_JUDGE=auto
# Inception (Mercury Decide screens, Mercury 3 decides). The API shuts down after 2026-12-28.
# In its API platform settings turn OFF "Improve the model for everyone" (otherwise it may train on chat text).
INCEPTION_API_KEY=
# Any OpenAI-compatible model that supports JSON-schema output; use it to replace Inception.
# BASE_URL is the SDK style URL (https://host/v1) or a bare host; http:// is only accepted for localhost.
SCOUT_LLM_BASE_URL=
SCOUT_LLM_API_KEY=
SCOUT_LLM_MODEL=

# all = judge every text message in enabled chats; signals = only ones people laughed at.
SCOUT_SCREEN=all
# Bars a clip must clear (starting points: calibrate them in dry-run).
SCOUT_DECIDE_FUNNY_MIN=0.85
SCOUT_DECIDE_STANDALONE_MIN=0.80
SCOUT_DECIDE_SENSITIVE_MAX=0.10
SCOUT_JUDGE_FUNNY_MIN=8
# Deleted messages are held to a stricter bar. SELFBOT_CLIP_DELETED: on = clip them in the chat,
# owner = DM them to you only, off = never.
SCOUT_DELETED_FUNNY_MIN=9
SCOUT_DELETED_SENSITIVE_MAX=0.05
SELFBOT_CLIP_DELETED=on
# Pacing, so the account stays quiet.
SCOUT_CHAT_COOLDOWN_MINUTES=15
SCOUT_AUTHOR_COOLDOWN_MINUTES=120
SCOUT_MAX_PER_HOUR=4
# In-memory only; nothing is written to disk except clips.jsonl, optout.json and scout-chats.json.
SCOUT_BUFFER_MINUTES=15
SCOUT_BUFFER_MAX_PER_CHAT=200
SCOUT_REACTION_WINDOW_SECONDS=45
SCOUT_TICK_SECONDS=5
SCOUT_MAX_CALLS_PER_DAY=2000
# Card theme: onyx (near-black) or dark (Discord's #313338).
CLIP_THEME=onyx
